/* =========================
HEATSYNC - CHICK-FIL-A STYLE
========================= */


* {
  box-sizing:border-box;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;
}


body {
  margin:0;
  background:#EEEDEB;
  color:#111827;
}


.app {
  max-width:1100px;
  margin:auto;
  padding:25px;
}



/* =========================
CARDS
========================= */


.card {

  background:white;

  border-radius:24px;

  padding:25px;

  margin-bottom:25px;

  box-shadow:0 8px 20px rgba(0,0,0,.08);

}



/* =========================
TEXT
========================= */


h1 {

  text-align:center;

}


.subtitle {

  text-align:center;

  color:#940929;

}



/* =========================
ALL BUTTON BASE
========================= */


button {

  border:none;

  border-radius:14px;

  padding:16px;

  font-size:18px;

  font-weight:700;

  cursor:pointer;

  color:white;

}



/* =========================
START SHIFT
========================= */


.start-button {

  width:100%;

  background:#DD0033;

}



/* =========================
ROTATION CONTROL BUTTONS
========================= */


.timer-buttons {

  display:flex;

  gap:15px;

}


.timer-buttons button {

  flex:1;

  background:#DAD7D2;

  color:#111827;

}



/* =========================
POSITION CARDS
========================= */


#dashboardPositions {

  display:grid;

  grid-template-columns:repeat(2,1fr);

  gap:20px;

}


.position-card {

  background:white;

  border-radius:22px;

  padding:25px;

  box-shadow:0 6px 15px rgba(0,0,0,.1);

}



.position-card h2 {

  text-align:center;

  font-size:30px;

}



.position-card p {

  font-size:20px;

}



/* =========================
ACTIVATE BUTTON ONLY
========================= */


.position-card button {

  background:#249E6B;

  width:100%;

}



/* =========================
ACTIVE TIMER "I'M BACK"
========================= */


.position-card.green button {

  background:#3EB1C8;

}



/* =========================
MANAGER ACTION AREA
========================= */


.manager-actions {

  display:flex;

  gap:12px;

  margin-top:15px;

}


.manager-actions button {

  flex:1;

}



/* ROTATE NOW */

.manager-actions button:first-child {

  background:#3EB1C8;

}



/* END POSITION */

.manager-actions button:last-child {

  background:#940929;

}



/* =========================
STATUS COLORS
========================= */


.green {

  border-left:12px solid #249E6B;

}


.yellow {

  border-left:12px solid #FFB549;

}


.red {

  border-left:12px solid #940929;

  background:#EEEDEB;

}



/* =========================
ATTENTION BANNER
========================= */


#attentionBanner {

  border-radius:18px;

  padding:20px;

  font-size:24px;

  font-weight:700;

  text-align:center;

}



/* =========================
RESET BUTTON
========================= */


.reset-shift-button {

  background:#940929;

  width:100%;

}



/* =========================
MOBILE
========================= */


@media(max-width:800px){

#dashboardPositions {

  grid-template-columns:1fr;

}


.timer-buttons {

  flex-direction:column;

}


.manager-actions {

  flex-direction:column;

}

}
.reset-shift-button {

background:#940929;

color:white;

width:100%;

margin-top:15px;

}
